# Audio
ro.audio.silent=0
ro.audio.flinger_standbytime_ms=1000
ro.audio.usb.period_us=16000
ro.camera.sound.forced=0

# Camera
ro.camera.notify_nfc=1

# Radio
persist.radio.nt.modem.svn=26
ro.vendor.mtk_gwsd_support=1
ro.vendor.vodata_support=1

# Media
media.stagefright.thumbnail.prefer_hw_codecs=true

# Wifi
wifi.direct.interface=p2p0
wifi.interface=wlan0
wifi.tethering.interface=ap0

# LightningOS
ro.lightning.display=1080 x 2400, 120 hz
ro.lightning.battery=5000mah
ro.lightning.soc=MediaTek Dimensity 7300
ro.lightning.camera=50MP + 2MP
ro.lightning.front=16MP
ro.lightning.platform=MT6878
ro.lightning.screen=6.67" Super AMOLED
ro.lightning.device.name=CMF Phone 1
